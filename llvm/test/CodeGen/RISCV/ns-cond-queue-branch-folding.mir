# RUN: llc -mtriple=riscv64 -run-pass=branch-folder %s -o - | FileCheck %s

# A conditional branch whose edges reach the same block is normally deleted.
# A PseudoNSQBR must survive: it consumes a condition from its queue, and
# without it every later execution would read the wrong one.

---
name:            plain_branch
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: plain_branch
  ; CHECK:       bb.0:
  ; CHECK-NOT:     PseudoBREQ
  ; CHECK:         PseudoRET
  bb.0:
    successors: %bb.1
    liveins: $x10, $x11

    PseudoBREQ $x10, $x11, %bb.1

  bb.1:
    PseudoRET
...
---
name:            queue_branch
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: queue_branch
  ; CHECK:       bb.0:
  ; CHECK:         PseudoNSQPush 0, $x10, $x11, 0
  ; CHECK-NEXT:    PseudoNSQBR 0, 0, %bb.1
  ; CHECK:       bb.1:
  bb.0:
    successors: %bb.1
    liveins: $x10, $x11

    PseudoNSQInit 0
    PseudoNSQPush 0, $x10, $x11, 0
    PseudoNSQBR 0, 0, %bb.1

  bb.1:
    PseudoRET
...
