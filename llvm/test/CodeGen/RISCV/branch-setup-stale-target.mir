# RUN: llc -mtriple=riscv64 -run-pass=riscv-branch-setup-hoisting -o - %s | FileCheck %s

---
name: stale_branch_target
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    $b0 = BMOVS_J <mcsymbol .Lbranch>
    $b0 = BMOVT_J $b0, %bb.3

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $b0
    PseudoPBC $b0, %bb.2

  bb.2:
    PseudoRET

  bb.3:
    PseudoRET
...

# CHECK-LABEL: name: stale_branch_target
# CHECK: $b0 = BMOVT_J $b0, %bb.2
# CHECK: PseudoPBC $b0, %bb.2
