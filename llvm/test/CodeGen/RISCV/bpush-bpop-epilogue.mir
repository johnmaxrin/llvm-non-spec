--- |
  define void @with_ld() { ret void }
  define void @with_bpop() { ret void }
...
---
name: with_ld
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $x10
    SD $x10, %stack.0, 0 :: (store (s64) into %stack.0)
    $x11 = LD %stack.0, 0 :: (load (s64) from %stack.0)
    PseudoRET implicit $x11
...
---
name: with_bpop
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 48, alignment: 16 }
body: |
  bb.0:
    liveins: $b0
    BPUSH $b0, %stack.0, 0 :: (store (s384) into %stack.0, align 16)
    $b1 = BPOP %stack.0, 0 :: (load (s384) from %stack.0, align 16)
    PseudoRET
...

# RUN: llc -mtriple=riscv64 -run-pass=prologepilog -o - %s | FileCheck %s
# CHECK-LABEL: name: with_bpop
# CHECK: ADDI $x2, -48
# CHECK: BPUSH $b0, $x2, 0
# CHECK: $b1 = BPOP $x2, 0
# CHECK: ADDI $x2, 48
