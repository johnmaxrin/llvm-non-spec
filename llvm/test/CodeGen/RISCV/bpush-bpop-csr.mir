# RUN: llc -mtriple=riscv64 -run-pass=prologepilog -o - %s \
# RUN:   | FileCheck --implicit-check-not='<badreg>' %s
--- |
  define void @uses_b24() { ret void }
...
---
name: uses_b24
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    dead $b24 = BMOVS_I $x10, 0
    PseudoRET
...
# CHECK: $x2 = frame-setup ADDI $x2, -48
# CHECK: frame-setup BPUSH killed $b24, $x2, 0
# CHECK: $b24 = frame-destroy BPOP $x2, 0
# CHECK: $x2 = frame-destroy ADDI $x2, 48
