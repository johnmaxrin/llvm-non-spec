# RUN: llc -mtriple=riscv64 -start-before=greedy -stop-after=prologepilog \
# RUN:   -o - %s | FileCheck %s
--- |
  declare void @foo()
  define void @spill_across_call() { ret void }
...
---
name: spill_across_call
tracksRegLiveness: true
frameInfo:
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    liveins: $x10
    %0:gpr = COPY $x10
    %1:pbr = BMOVS_I %0, 0
    ADJCALLSTACKDOWN 0, 0, implicit-def $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @foo, csr_ilp32_lp64, implicit-def $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def $x2, implicit $x2
    BPUSH %1, $x2, 0
    PseudoRET
...
# CHECK: size: 48
# CHECK-NOT: scalable-vector
# CHECK: BPUSH
# CHECK: PseudoCALL
# CHECK: BPOP
